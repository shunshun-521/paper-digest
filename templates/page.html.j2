<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>论文日报 {{ day.isoformat() }}</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f5f7fa;
      --card: #ffffff;
      --text: #1c2430;
      --muted: #5c6b7a;
      --line: #e4e9ef;
      --accent: #145ea8;
      --chip: #eef3f8;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #12161c;
        --card: #1c232c;
        --text: #e8eef5;
        --muted: #a8b3c0;
        --line: #2c3642;
        --accent: #8eb7e8;
        --chip: #243140;
      }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;
      line-height: 1.65;
    }
    header, main { width: min(880px, calc(100% - 28px)); margin: 0 auto; }
    header { padding: 28px 0 8px; }
    .kicker { letter-spacing: 0.08em; font-size: 12px; color: var(--muted); }
    h1 { font-size: 32px; line-height: 1.25; margin: 6px 0; }
    .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0; }
    .filters label {
      display: inline-flex; gap: 6px; align-items: center;
      background: var(--card); border: 1px solid var(--line); border-radius: 999px;
      padding: 6px 10px; font-size: 14px;
    }
    .toolbar { display: flex; justify-content: space-between; gap: 12px; align-items: center; margin-bottom: 12px; }
    button {
      background: var(--card); color: var(--text); border: 1px solid var(--line);
      border-radius: 8px; padding: 8px 12px; font: inherit; cursor: pointer;
    }
    article {
      background: var(--card); border: 1px solid var(--line); border-radius: 14px;
      padding: 20px; margin: 0 0 16px;
    }
    article h2 { margin: 0 0 8px; font-size: 22px; line-height: 1.35; }
    .lede { color: var(--muted); margin-top: 0; }
    img { width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--line); }
    .cap { color: var(--muted); font-size: 14px; margin-top: 6px; }
    .tags { display: flex; flex-wrap: wrap; gap: 6px; }
    .tags span { background: var(--chip); border-radius: 999px; padding: 2px 8px; font-size: 13px; }
    a { color: var(--accent); }
    footer { width: min(880px, calc(100% - 28px)); margin: 8px auto 40px; color: var(--muted); font-size: 14px; }
  </style>
</head>
<body>
  <header>
    <div class="kicker">DAILY PAPER DIGEST</div>
    <h1>论文日报</h1>
    <div>{{ day.strftime("%Y年%m月%d日") }} · <span id="count"></span></div>
    <div class="filters" id="filters">
      {% for topic in topics %}
      <label><input type="checkbox" data-topic value="{{ topic.id }}" data-default="{{ '1' if topic.default else '0' }}"> {{ topic.name }}</label>
      {% endfor %}
    </div>
    <div class="toolbar">
      <span>勾选主题后按相关度重新排序</span>
      <button type="button" id="toggle">显示全部候选</button>
    </div>
  </header>
  <main id="list">
    {% for paper in papers %}
    {% set article = paper.article %}
    <article data-paper data-scores="{{ paper.topic_scores | tojson | forceescape }}">
      <h2>{{ article.headline if article else paper.title }}</h2>
      <p class="lede">{{ article.lede if article else "" }}</p>
      {% if paper.figure and paper.figure.filename %}
      <img src="img/{{ paper.figure.filename }}" alt="{{ article.figure_caption_zh if article else '' }}">
      <div class="cap">{{ article.figure_caption_zh if article else paper.figure.caption }}</div>
      {% endif %}
      {% if article %}
      <p><strong>解决了什么问题。</strong>{{ article.problem }}</p>
      <p><strong>方法。</strong>{{ article.method }}</p>
      <p><strong>关键结果。</strong>{{ article.results }}</p>
      <p><strong>为什么值得看。</strong>{{ article.why_it_matters }}</p>
      <p><strong>局限 / 存疑。</strong>{{ article.limitations }}</p>
      {% endif %}
      <div class="tags">
        {% for topic_id in paper.matched_topics %}
        <span>{{ topic_names.get(topic_id, topic_id) }}</span>
        {% endfor %}
      </div>
      <p><a href="https://www.alphaxiv.org/abs/{{ paper.arxiv_id }}">alphaXiv</a> · <a href="https://arxiv.org/abs/{{ paper.arxiv_id }}">arXiv</a></p>
    </article>
    {% endfor %}
    {% if journals %}
    <article>
      <h2>期刊</h2>
      {% for note in journals %}
      <p><strong>{{ note.source }}</strong> · {% if note.url %}<a href="{{ note.url }}">{{ note.title }}</a>{% else %}{{ note.title }}{% endif %}<br>{{ note.blurb or note.summary }}</p>
      {% endfor %}
    </article>
    {% endif %}
  </main>
  <footer>
    <p>今日数据源状态：{{ status_line }}</p>
    <p><a href="../index.html">全部日期</a></p>
  </footer>
  <script>
    (function () {
      var PER_DAY = {{ papers_per_day }};
      var KEY = "paper-digest-topics";
      var boxes = Array.prototype.slice.call(document.querySelectorAll("[data-topic]"));
      var cards = Array.prototype.slice.call(document.querySelectorAll("[data-paper]"));
      var showAll = false;
      var toggle = document.getElementById("toggle");
      function load() {
        try {
          var raw = localStorage.getItem(KEY);
          if (raw) {
            var saved = JSON.parse(raw);
            boxes.forEach(function (box) { box.checked = !!saved[box.value]; });
            return;
          }
        } catch (err) {}
        boxes.forEach(function (box) { box.checked = box.getAttribute("data-default") === "1"; });
      }
      function save() {
        var payload = {};
        boxes.forEach(function (box) { payload[box.value] = box.checked; });
        try { localStorage.setItem(KEY, JSON.stringify(payload)); } catch (err) {}
      }
      function selected() {
        return boxes.filter(function (box) { return box.checked; }).map(function (box) { return box.value; });
      }
      function scoreOf(card, ids) {
        var scores = {};
        try { scores = JSON.parse(card.getAttribute("data-scores") || "{}"); } catch (err) {}
        var best = 0;
        ids.forEach(function (id) {
          var value = Number(scores[id] || 0);
          if (value > best) best = value;
        });
        return best;
      }
      function render() {
        var ids = selected();
        var ranked = cards.map(function (card) { return { el: card, score: scoreOf(card, ids) }; })
          .filter(function (item) { return item.score >= 6; })
          .sort(function (a, b) { return b.score - a.score; });
        cards.forEach(function (card) { card.style.display = "none"; });
        var limit = showAll ? ranked.length : Math.min(ranked.length, PER_DAY);
        for (var i = 0; i < limit; i++) ranked[i].el.style.display = "";
        document.getElementById("count").textContent = "显示 " + limit + " / " + ranked.length + " 篇";
        toggle.textContent = showAll ? "只看前几篇" : "显示全部候选";
      }
      boxes.forEach(function (box) {
        box.addEventListener("change", function () { save(); render(); });
      });
      toggle.addEventListener("click", function () { showAll = !showAll; render(); });
      load();
      render();
    })();
  </script>
</body>
</html>
